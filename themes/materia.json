{
    "$schema": "vscode://schemas/color-theme",
    "name": "materia",
    "type": "dark",
    "include": "./tokens-dark.json",
    "colors": {
        // Blue - #07C
        // BrightBlue - #5BE
        // Backgrounds
        "titleBar.activeBackground": "#292929", // also the main app background
        "sideBar.background": "#292929",
        "activityBar.background": "#292929",
        "statusBar.background": "#292929",
        "panel.background": "#242424",
        "editor.background": "#242424",
        "editor.lineHighlightBackground": "#1A1A1A",
        // Foregrounds
        "tab.inactiveForeground": "#FFF7",
        "editorRuler.foreground": "#FF1",
        "editor.selectionBackground": "#FFF1",
        "editorLineNumber.foreground": "#FFF2",
        "list.activeSelectionBackground": "#FFF2",
        "titleBar.inactiveForeground": "#FFF7",
        "quickInput.foreground": "#FFF7",
        "sideBar.foreground": "#FFF8",
        "statusBar.foreground": "#FFF7",
        "editorLineNumber.activeForeground": "#FFF7",
        "gitDecoration.ignoredResourceForeground": "#EFF5",
        // Borders
        "focusBorder": "#EFF1",
        "panel.border": "#303030",
        "editorGroup.border": "#303030",
        "sideBar.border": "#303030",
        // Void/transparent
        "surface.border": "#0000",
        "terminal.border": "#0000",
        "statusBar.border": "#0000",
        "statusBarItem.remoteBackground": "#0000",
        "sideBarSectionHeader.background": "#0000",
        "tab.inactiveBackground": "#0000",
        "editorGroupHeader.tabsBackground": "#0000",
        // Blues
        "tab.activeBorder": "#5BE",
        "statusBarItem.remoteForeground": "#5BE",
        "panelTitle.activeBorder": "#5BE",
    }
}
