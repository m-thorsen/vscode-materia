{
    "$schema": "vscode://schemas/color-theme",
    "name": "materia",
    "type": "dark",
    "include": "./tokens-dark.json",
    "colors": {
        // Blue-30 - #0079ce
        // Blue-15 - #0092fa
        // Blue - #28A6FF
        // Backgrounds
        "editor.lineHighlightBackground": "#1A1A1A",
        "editor.background": "#242424",
        "panel.background": "#242424",
        "activityBar.background": "#272727",
        "sideBar.background": "#272727",
        "statusBar.background": "#272727",
        // Foregrounds
        "editorRuler.foreground": "#EFF1",
        "editor.selectionBackground": "#EFF1",
        "editorLineNumber.foreground": "#EFF2",
        "list.activeSelectionBackground": "#EFF2",
        "titleBar.inactiveForeground": "#EFF7",
        "quickInput.foreground": "#EFF7",
        "sideBar.foreground": "#EFF8",
        "statusBar.foreground": "#EFF7",
        "statusBarItem.remoteForeground": "#EFF8",
        "editorLineNumber.activeForeground": "#EFF7",
        "gitDecoration.ignoredResourceForeground": "#EFF5",
        // Borders
        "focusBorder": "#EFF1",
        "titleBar.activeBackground": "#303030",
        "panel.border": "#303030",
        "editorGroup.border": "#303030",
        "sideBar.border": "#303030",
        "statusBar.border": "#303030",
        // Void/transparent
        "terminal.border": "#0000",
        "statusBarItem.remoteBackground": "#0000",
        "sideBarSectionHeader.background": "#0000",
        "tab.activeBackground": "#0000",
        "tab.border": "#0000",
        "tab.inactiveBackground": "#0000",
        "editorGroupHeader.tabsBackground": "#0000",
        // Blues
        "tab.activeBorder": "#28A6FF",
        "panelTitle.activeBorder": "#28A6FF",
        "activityBar.activeBorder": "#28A6FF",
    }
}
